// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
// These two values are the ones to change for your own build:
//   PRODUCT_BUNDLE_IDENTIFIER - any identifier you can sign with, for example
//     com.example.trackscout. The app does not depend on a particular id.
//   DEVELOPMENT_TEAM - your 10-character Apple Developer team id
//     (Xcode > Settings > Accounts). The value committed here is a documented
//     default for the reference setup; replace it with your own team.
PRODUCT_NAME = TrackScout
PRODUCT_DISPLAY_NAME = TrackScout
PRODUCT_BUNDLE_IDENTIFIER = com.welivelikethis.trackscout
DEVELOPMENT_TEAM = VLE9UF43XH
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = 17.0

// (1 == iPhone, 2 == iPad)
TARGETED_DEVICE_FAMILY = 1

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/TrackScout.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/TrackScout.entitlements
